{
  "name": "@template/web",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/api/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "start": "bun src/__server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "cd ../.. && oxlint packages/web --deny-warnings --no-error-on-unmatched-pattern",
    "preview": "bun run build && vite preview",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@libsql/client": "^0.17.2",
    "@orpc/client": "^1.14.7",
    "@orpc/server": "^1.14.7",
    "@orpc/tanstack-query": "^1.14.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@runablehq/website-runtime": "^0.10.0",
    "@tanstack/react-query": "^5.100.6",
    "ai": "6.0.239",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "fontkit": "^3.0.0",
    "hono": "^4.12.10",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "opentype.js": "1.3.4",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.5.0",
    "wouter": "^3.9.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/bun": "latest",
    "@types/fontkit": "^2.0.9",
    "@types/jsbarcode": "^3.11.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.3.5",
    "@types/opentype.js": "^1.3.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.4",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.1.4",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.1"
  }
}
